@model AcademicManagementSystem.Models.CourseModel

<div class="mb-3">
    <label asp-for="@Model.Name" class="form-label-custom"></label>
    <input type="text" asp-for="@Model.Name" class="form-control-custom" placeholder="Enter Name" />
    <span asp-validation-for="@Model.Name" class="alert-custom-content"></span>
</div>

<div class="mb-3">
    <label asp-for="@Model.DepartmentId" class="form-label-custom"></label>
    <select asp-for="@Model.DepartmentId" class="form-control-custom" placeholder="Select Department">
        <option value="">Select Department</option>
        @foreach (var department in Model.AvailableDepartments)
        {
            <option value="@department.Value">@department.Text</option>
        }
    </select>
    <span asp-validation-for="@Model.DepartmentId" class="alert-custom-content"></span>
</div>

<div class="mb-3">
    <label asp-for="@Model.Fee" class="form-label-custom"></label>
    <input type="number" asp-for="@Model.Fee" class="form-control-custom" placeholder="Enter Fee" />
    <span asp-validation-for="@Model.Fee" class="alert-custom-content"></span>
</div>

<button class="btn-custom btn-custom-primary" type="submit">Save Course</button>