@model AcademicManagementSystem.Models.RoleModel

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label-custom"></label>
    <input type="text" asp-for="Name" class="form-control-custom" placeholder="Enter Role Name" />
    <span asp-validation-for="Name" class="alert-custom-content"></span>
</div>

<div class="form-check-custom">
    <input type="checkbox" asp-for="IsActive" class="form-check-input-custom" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>

<button class="btn-custom btn-custom-primary" type="submit">Save Role</button>
