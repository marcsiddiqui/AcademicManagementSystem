@model AcademicManagementSystem.Models.RoleListModel
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<div class="page-header">
    <div>
        <h1 class="page-title">Roles</h1>
        <p class="page-subtitle">An easy way to manage roles.</p>
    </div>
</div>

<div class="table-card-custom">
    <form asp-action="Index" method="get">
        <div class="table-header-control">
            <div class="table-search-box">
                <i class="bi bi-search table-search-icon"></i>
                <input type="text" asp-for="SearchText" class="form-control-custom" placeholder="Search Roles by Name ..." />
                <button class="btn-custom btn-custom-primary" type="submit">Search</button>
                <button id="clearBtn" class="btn-custom btn-custom-primary" type="button">Clear</button>
            </div>
            <div class="table-filter-group">
                <div class="dropdown">
                    <select class="btn-table-action dropdown-toggle" asp-for="StatusId">
                        <option value="0">All Statuses</option>
                        <option value="1">Active</option>
                        <option value="2">In Active</option>
                    </select>
                </div>
                <div class="dropdown">
                    <select class="btn-table-action dropdown-toggle" asp-for="SortById">
                        <option value="0">default</option>
                        <option value="1">name_desc</option>
                    </select>
                </div>
                <button class="btn-table-action" type="button">
                    <a asp-action="Create"><i class="bi bi-file-earmark-arrow-down"></i> + Add</a>
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Is Active</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td class="table-order-id">#@role.Id</td>
                        <td class="table-product-name">@role.Name</td>
                        <td><span class="badge-table @(role.IsActive ? "success" : "failed")">@(role.IsActive ? "Active" : "In Active")</span></td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <a title="Edit row" class="table-btn-action" asp-action="Detail" asp-route-id="@role.Id"><i class="bi bi-pencil"></i></a>
                                <a title="Delete row" class="table-btn-action delete" asp-action="Delete" asp-route-id="@role.Id"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer-control">
        <span class="table-pagination-info">Showing @Model.ShowingFrom to @Model.ShowingTo of @Model.TotalRecords entries</span>
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0 gap-1">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchText="@Model.SearchText" asp-route-statusId="@Model.StatusId" asp-route-sortById="@Model.SortById" class="page-link border-0"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@i" asp-route-searchText="@Model.SearchText" asp-route-statusId="@Model.StatusId" asp-route-sortById="@Model.SortById" class="page-link border-0">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchText="@Model.SearchText" asp-route-statusId="@Model.StatusId" asp-route-sortById="@Model.SortById" class="page-link border-0"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#clearBtn").click(function () {
            $("#SearchText").val("");
            $("#StatusId").val(0);
            $("#SortById").val(0);
        });
    });
</script>
