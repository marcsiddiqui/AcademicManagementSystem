@model AcademicManagementSystem.Models.DepartmentModel

<div class="page-header">
    <div>
        <h1 class="page-title">Add New Department</h1>
        <p class="page-subtitle">An easy way to manage departments.</p>
    </div>
</div>

<div class="row g-4 mb-4">

    <!-- Column 1: Basic controls -->
    <div class="col-12 col-lg-6">
        <div class="card border-light shadow-sm p-4 h-100">
            <h5 class="card-title mb-4">Department Info</h5>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <h4>Are you sure you want to delete Department @Model.Name?</h4>

                <div class="mt-4">
                    <button type="submit" class="btn-custom btn-custom-danger">Delete</button>
                    <a asp-action="Index" class="btn-custom btn-custom-secondary">Cancel</a>
                </div>

            </form>

        </div>
    </div>

</div>