@model AcademicManagementSystem.Models.StudentListModel
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<div class="page-header">
    <div>
        <h1 class="page-title">Students</h1>
        <p class="page-subtitle">An easy way to manage students.</p>
    </div>
</div>

<!-- START: Basic Table Card Container -->
<div class="table-card-custom">
    <form>
        <!-- Header Controls -->
        <div class="table-header-control">
            <!-- Search bar -->
            <div class="table-search-box">
                <i class="bi bi-search table-search-icon"></i>
                <input type="text" asp-for="@Model.SearchText" class="form-control-custom" placeholder="Search Students by Name, Email or Phone ..." />
                <button class="btn-custom btn-custom-primary" type="submit">Search</button>
                <button id="clearBtn" class="btn-custom btn-custom-primary" type="button">Clear</button>
                <script>
                    $(document).ready(function(){
                        $("#clearBtn").click(function(){
                            $("#SearchText").val("");
                            $("#StatusId").val(0);
                            $("#SortById").val(0);
                        });
                    });
                </script>
            </div>
            <!-- Action buttons / Filter options -->
            <div class="table-filter-group">
                <div class="dropdown">
                    <select class="btn-table-action dropdown-toggle" asp-for="@Model.StatusId" data-bs-toggle="dropdown" aria-expanded="false">
                        <option class="dropdown-item" value="0">All Statuses</option>
                        <option class="dropdown-item" value="1">Active</option>
                        <option class="dropdown-item" value="2">In Active</option>
                    </select>
                </div>
                <div class="dropdown">
                    <select class="btn-table-action dropdown-toggle" asp-for="@Model.SortById" data-bs-toggle="dropdown" aria-expanded="false">
                        <option class="dropdown-item" value="0">default</option>
                        <option class="dropdown-item" value="1">name_desc</option>
                        <option class="dropdown-item" value="2">admission_date</option>
                        <option class="dropdown-item" value="3">admission_date_desc</option>
                    </select>
                </div>
                <button class="btn-table-action" type="button">
                    <a asp-action="Create"><i class="bi bi-file-earmark-arrow-down"></i> + Add</a>
                </button>
            </div>
        </div>
    </form>

    <!-- Responsive Table Wrapper -->
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Date Of Birth</th>
                    <th>Admission Date</th>
                    <th>Is Active</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td class="table-order-id">#@student.Id</td>
                        <td class="table-product-name">@student.StudentFullName</td>
                        <td class="table-product-name">@student.Email</td>
                        <td class="table-product-name">@student.Phone</td>
                        <td class="table-product-name">@student.Gender</td>
                        <td class="table-product-name">@student.DateOfBirth</td>
                        <td class="table-product-name">@student.AdmissionDate</td>
                        <td><span class="badge-table @(student.IsActive ? "success" : "failed")">@(student.IsActive ? "Active" : "In Active")</span></td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <a title="Edit row" class="table-btn-action" asp-area="" asp-controller="Student" asp-action="Detail" asp-route-id="@student.Id"><i class="bi bi-pencil"></i></a>
                                <a title="Delete row" class="table-btn-action delete" asp-area="" asp-controller="Student" asp-action="Delete" asp-route-id="@student.Id"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Footer Controls / Pagination -->
    <div class="table-footer-control">
        <span class="table-pagination-info">Showing 1 to @Model.Students.Count of @Model.Students.Count entries</span>
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0 gap-1">
                <li class="page-item disabled">
                    <a class="page-link border-0" href="#"><i class="bi bi-chevron-left"></i></a>
                </li>
                <li class="page-item active"><a class="page-link border-0" href="#">1</a></li>
                <li class="page-item"><a class="page-link border-0" href="#">2</a></li>
                <li class="page-item"><a class="page-link border-0" href="#">3</a></li>
                <li class="page-item"><a class="page-link border-0" href="#"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </nav>
    </div>
</div>
<!-- END: Basic Table Card Container -->